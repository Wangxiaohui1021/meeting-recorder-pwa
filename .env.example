# 复制为 .env 并填入你自己的密钥。不填则自动使用 mock 演示模式。

# 使用的云服务商：iflytek（默认，推荐）| dashscope | mock
PROVIDER=iflytek

# 讯飞开放平台（转写 + 星火纪要一体）
# 控制台 https://www.xfyun.cn/ -> 创建应用，开通「语音转写」与「星火认知大模型」
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# 阿里云百炼 / 通义（仅纪要，转写需可访问 URL，见 dashscope.js 注释）
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus

# 服务端口
PORT=3000
